{
  "name": "celestial-flight-viture-pro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "夜の航路 — 初代VITURE Pro向け星空・プラネタリウム",
  "scripts": {
    "start": "python3 outputs/launch.py",
    "test": "node work/run-verify.mjs",
    "format": "prettier --write \"outputs/*.{js,css,html}\" \"work/*.mjs\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"outputs/*.{js,css,html}\" \"work/*.mjs\" \"scripts/*.mjs\"",
    "build:standalone": "node scripts/build-standalone.mjs"
  },
  "devDependencies": {
    "esbuild": "0.24.0",
    "prettier": "3.3.3"
  }
}
